# Copy to .env before starting the local PostgreSQL container.
# Development only. Never reuse this password for a deployed environment.
DB_PASSWORD=replace_with_local_password
# Host port for local PostgreSQL; use 15432 if 5432 is already occupied.
DB_PORT=5432
# Optional one-time bootstrap for an empty database. Set both before first backend start,
# then remove them from your local .env after the initial system admin exists.
# BOOTSTRAP_ADMIN_LOGIN=your_admin_login
# BOOTSTRAP_ADMIN_PASSWORD=use_a_unique_password_of_at_least_12_characters
# Set true only when the backend is behind HTTPS in deployment.
# SESSION_COOKIE_SECURE=false
